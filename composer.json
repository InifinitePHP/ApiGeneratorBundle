{
    "name": "rehark/api-generator-bundle",
    "description": "A Symfony-based API to generate resources very fast.",
    "type": "symfony-bundle",
    "license": "MIT",
    "autoload": {
        "psr-4": {
            "Rehark\\ApiGeneratorBundle\\": "src/",
            "Rehark\\ApiGeneratorBundle\\Tests\\": "tests/"
        }
    },
    "authors": [
        {
            "name": "Vincent CLERC",
            "email": "contact@vincent-clerc.net"
        }
    ],
    "require": {
        "symfony/framework-bundle": "^7.4",
        "symfony/console": "^7.4",
        "doctrine/orm": "^3.6",
        "symfony/serializer-pack": "^1.3",
        "symfony/validator": "^7.4 || ^8.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5",
        "phpstan/phpstan": "^2.1",
        "phpstan/phpstan-symfony": "^2.0"
    }
}
